# Server-only settings. No service-role key is needed or accepted.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Admin membership is provisioned in private.site_admin, never environment variables.
# Local dev: http://127.0.0.1:3000 ; production: https://bartconsedine.com
SITE_URL=http://127.0.0.1:3000

# Migration tools only: provide DATABASE_URL through a protected process environment.
# Use direct PostgreSQL or session pooler (5432), never the transaction pooler.
# Do not add database credentials to the deployed application.
# DATABASE_URL=
# BACKUP_DIR=/absolute/path/to/protected-local-backups (0700; outside Git)
# PG_BIN_DIR=/path/to/postgresql-17-or-newer/bin
