// Prisma Migrate is the only migration runner. No Prisma Client is used at runtime.
// Reviewed migration.sql files are authoritative for RLS, grants, functions,
// constraints, and Auth foreign keys. Supabase owns auth/storage schemas.
// Do not use db push or schema-generated migration diffs on the hosted project.
datasource db {
  provider = "postgresql"
  schemas  = ["public", "private"]
}

model MorningNewsSettings {
  singleton Boolean @id @default(true)
  enabled Boolean @default(false)
  @@map("morning_news_settings")
  @@schema("private")
}

model MorningNewsRead {
  owner_id String @db.Uuid
  article_id String
  read_at DateTime @default(now()) @db.Timestamptz(6)
  @@id([owner_id, article_id])
  @@map("morning_news_reads")
  @@schema("private")
}

// These models document application columns; cross-schema Auth FKs and security
// features live in SQL. Use `npm run db:migration:new -- name` for SQL migrations.
model AppData {
  owner_id   String   @default(dbgenerated("auth.uid()")) @db.Uuid
  app_slug   String
  key        String
  value      Json     @default("{}")
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@id([owner_id, app_slug, key])
  @@map("app_data")
  @@schema("public")
}

model SiteAdmin {
  user_id     String   @id @db.Uuid
  email       String   @unique
  enrolled_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("site_admin")
  @@schema("private")
}

model AppAccessGrant {
  owner_id      String   @db.Uuid
  app_slug      String
  invited_email String
  role          String
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  @@id([owner_id, app_slug, invited_email])
  @@index([invited_email], map: "app_grants_recipient")
  @@map("app_access_grants")
  @@schema("public")
}

model RobotPartyMessage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id     String   @db.Uuid
  parent_id    String?  @db.Uuid
  author_id    String   @db.Uuid
  actor_kind   String   @default("human")
  robot_id     String?  @db.Uuid
  author_label String   @default("")
  robot_name   String   @default("")
  kind         String
  status       String   @default("")
  title        String   @default("")
  body         String
  tags         String[] @default([])
  project_url  String   @default("")
  removed_at   DateTime? @db.Timestamptz(6)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)
  search_text  String?  @default(dbgenerated())

  @@unique([owner_id, id])
  @@map("robot_party_messages")
  @@schema("public")
}

model RobotPartyRobot {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 owner_id String @db.Uuid
 created_by String @db.Uuid
 name String
 grant_revision DateTime? @db.Timestamptz(6)
 token_hash String @unique
 role String
 expires_at DateTime @default(dbgenerated("now() + interval '90 days'")) @db.Timestamptz(6)
 revoked_at DateTime? @db.Timestamptz(6)
 last_write_at DateTime? @db.Timestamptz(6)
 created_at DateTime @default(now()) @db.Timestamptz(6)
 updated_at DateTime @default(now()) @db.Timestamptz(6)
 @@map("robot_party_robots")
 @@schema("public")
}

model RobotPartyOauthCode {
 code_hash String @id
 robot_id String @db.Uuid
 client_id String
 redirect_uri String
 resource String
 challenge String
 created_at DateTime @default(now()) @db.Timestamptz(6)
 expires_at DateTime @default(dbgenerated("clock_timestamp() + interval '5 minutes'")) @db.Timestamptz(6)
 consumed_at DateTime? @db.Timestamptz(6)
 @@map("robot_party_oauth_codes")
 @@schema("public")
}

model ProjectBoardProject {
  owner_id String @default(dbgenerated("auth.uid()")) @db.Uuid
  id String @db.Uuid
  title String
  description String @default("")
  source_url String @default("")
  created_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  updated_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  revision Int @default(1)
  @@id([owner_id, id])
  @@map("project_board_projects")
  @@schema("public")
}
model ProjectBoardTask {
  owner_id String @default(dbgenerated("auth.uid()")) @db.Uuid
  id String @db.Uuid
  project_id String @db.Uuid
  title String
  description String @default("")
  status String @default("backlog")
  priority String @default("medium")
  due_date DateTime? @db.Date
  source_url String @default("")
  calendar_id String?
  event_id String?
  kind String @default("task")
  next_action String @default("")
  blocked_reason String @default("")
  blocker_task_id String? @db.Uuid
  evidence Json @default("[]")
  created_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  updated_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  revision Int @default(1)
  @@id([owner_id, id])
  @@map("project_board_tasks")
  @@schema("public")
}

model ProjectBoardJob {
 owner_id String @default(dbgenerated("auth.uid()")) @db.Uuid
 id String @db.Uuid
 project_id String? @db.Uuid
 title String
 description String @default("")
 status String @default("draft")
 provider String @default("dot")
 provider_job_id String?
 provider_revision String?
 timezone String?
 next_action String @default("")
 evidence Json @default("[]")
 created_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
 updated_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
 revision Int @default(1)
 @@id([owner_id,id])
 @@unique([owner_id,provider,provider_job_id])
 @@map("project_board_jobs")
 @@schema("public")
}
model ProjectBoardSchedule {
 owner_id String @default(dbgenerated("auth.uid()")) @db.Uuid
 id String @db.Uuid
 job_id String @db.Uuid
 provider String @default("dot")
 provider_schedule_id String?
 status String @default("unverified")
 expression String @default("")
 timezone String?
 next_scheduled_at DateTime? @db.Timestamptz(6)
 last_verified_at DateTime? @db.Timestamptz(6)
 evidence Json @default("[]")
 created_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
 updated_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
 revision Int @default(1)
 @@id([owner_id,id])
 @@unique([owner_id,provider,provider_schedule_id])
 @@map("project_board_schedules")
 @@schema("public")
}
model ProjectBoardRun {
 owner_id String @default(dbgenerated("auth.uid()")) @db.Uuid
 id String @db.Uuid
 job_id String? @db.Uuid
 job_revision Int?
 task_id String? @db.Uuid
 task_revision Int?
 provider String @default("dot")
 provider_run_id String?
 status String @default("requested")
 mode String @default("action")
 request_summary String
 requires_approval Boolean @default(true)
 timezone String @default("America/New_York")
 scheduled_at DateTime? @db.Timestamptz(6)
 accepted_at DateTime? @db.Timestamptz(6)
 started_at DateTime? @db.Timestamptz(6)
 completed_at DateTime? @db.Timestamptz(6)
 verified_at DateTime? @db.Timestamptz(6)
 outcome String @default("")
 next_action String @default("")
 evidence Json @default("[]")
 request_message_id String? @unique @db.Uuid
 dispatched_revision Int?
 created_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
 updated_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
 revision Int @default(1)
 @@id([owner_id,id])
 @@unique([owner_id,provider,provider_run_id])
 @@map("project_board_runs")
 @@schema("public")
}
model ProjectBoardApproval {
 owner_id String @default(dbgenerated("auth.uid()")) @db.Uuid
 id String @db.Uuid
 run_id String @db.Uuid
 run_revision Int
 status String @default("pending")
 summary String @default("")
 decided_at DateTime? @db.Timestamptz(6)
 created_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
 updated_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
 revision Int @default(1)
 @@id([owner_id,id])
 @@unique([owner_id,run_id,run_revision])
 @@map("project_board_approvals")
 @@schema("public")
}
model ProjectBoardDelivery {
 owner_id String @default(dbgenerated("auth.uid()")) @db.Uuid
 id String @db.Uuid
 run_id String @db.Uuid
 kind String @default("result")
 provider String @default("dot")
 provider_delivery_id String?
 status String @default("queued")
 message_id String? @db.Uuid
 scheduled_at DateTime? @db.Timestamptz(6)
 received_at DateTime? @db.Timestamptz(6)
 started_at DateTime? @db.Timestamptz(6)
 delivered_at DateTime? @db.Timestamptz(6)
 verified_at DateTime? @db.Timestamptz(6)
 next_action String @default("")
 evidence Json @default("[]")
 created_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
 updated_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
 revision Int @default(1)
 @@id([owner_id,id])
 @@unique([owner_id,provider,kind,provider_delivery_id])
 @@unique([owner_id,message_id])
 @@map("project_board_deliveries")
 @@schema("public")
}
model ProjectBoardEvent {
 owner_id String @db.Uuid
 id String @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 run_id String @db.Uuid
 provider String @default("dot")
 provider_event_id String
 kind String
 occurred_at DateTime? @db.Timestamptz(6)
 source_message_id String @db.Uuid
 payload Json
 created_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
 @@id([owner_id,id])
 @@unique([owner_id,provider,provider_event_id])
 @@unique([owner_id,source_message_id])
 @@map("project_board_events")
 @@schema("public")
}

// SQL enforces capability-only access; no table grants to API roles.
model MorningTvDevice {
 device_hash String @id
 approval_hash String @unique
 owner_id String? @db.Uuid
 created_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
 pairing_expires_at DateTime @default(dbgenerated("clock_timestamp() + interval '10 minutes'")) @db.Timestamptz(6)
 expires_at DateTime? @db.Timestamptz(6)
 revoked_at DateTime? @db.Timestamptz(6)
 @@index([owner_id])
 @@map("morning_tv_devices")
 @@schema("private")
}

model RobotPartyPersonalChannel {
  id String @id @db.Uuid
  owner_id String @db.Uuid
  robot_id String @db.Uuid
  created_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  @@map("robot_party_personal_channels")
  @@schema("public")
}
model RobotPartyPersonalMessage {
  id String @id @db.Uuid
  channel_id String @db.Uuid
  owner_id String @db.Uuid
  sender String
  robot_id String? @db.Uuid
  reply_to String? @db.Uuid
  body String
  seq BigInt @unique @default(autoincrement())
  created_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  @@unique([owner_id,id], map:"robot_party_personal_message_owner_id")
  @@map("robot_party_personal_messages")
  @@schema("public")
}
model RobotPartyPersonalSubscription {
  id String @id
  channel_id String @unique @db.Uuid
  callback_url String
  secret_box String
  expires_at DateTime @db.Timestamptz(6)
  active Boolean @default(true)
  @@map("robot_party_personal_subscriptions")
  @@schema("private")
}
model RobotPartyPersonalOutbox {
  message_id String @id @db.Uuid
  channel_id String @db.Uuid
  subscription_id String
  state String @default("queued")
  attempts Int @default(0)
  next_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  lease_id String? @db.Uuid
  lease_until DateTime? @db.Timestamptz(6)
  received_at DateTime? @db.Timestamptz(6)
  @@map("robot_party_personal_outbox")
  @@schema("private")
}

// SQL enforces capability-only relay and per-session revocation. Auth owns sessions.
model AdminQrRequest {
 device_hash String @id
 approval_hash String @unique
 label String
 oauth_url String
 owner_id String? @db.Uuid
 created_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
 deadline DateTime @default(dbgenerated("clock_timestamp() + interval '10 minutes'")) @db.Timestamptz(6)
 auth_code String?
 claimed Boolean @default(false)
 session_id String? @unique @db.Uuid
 expires_at DateTime? @db.Timestamptz(6)
 revoked_at DateTime? @db.Timestamptz(6)
 @@map("admin_qr_requests")
 @@schema("private")
}
