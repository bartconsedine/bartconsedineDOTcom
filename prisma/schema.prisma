// Prisma Migrate is the only migration runner. No Prisma Client is used at runtime.
// Reviewed migration.sql files are authoritative for RLS, grants, functions,
// constraints, and Auth foreign keys. Supabase owns auth/storage schemas.
// Do not use db push or schema-generated migration diffs on the hosted project.
datasource db {
  provider = "postgresql"
  schemas  = ["public", "private"]
}

// These models document application columns; cross-schema Auth FKs and security
// features live in SQL. Use `npm run db:migration:new -- name` for SQL migrations.
model AppData {
  owner_id   String   @default(dbgenerated("auth.uid()")) @db.Uuid
  app_slug   String
  key        String
  value      Json     @default("{}")
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@id([owner_id, app_slug, key])
  @@map("app_data")
  @@schema("public")
}

model SiteAdmin {
  user_id     String   @id @db.Uuid
  email       String   @unique
  enrolled_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("site_admin")
  @@schema("private")
}

model AppAccessGrant {
  owner_id      String   @db.Uuid
  app_slug      String
  invited_email String
  role          String
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  @@id([owner_id, app_slug, invited_email])
  @@index([invited_email], map: "app_grants_recipient")
  @@map("app_access_grants")
  @@schema("public")
}

model RobotPartyMessage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id     String   @db.Uuid
  parent_id    String?  @db.Uuid
  author_id    String   @db.Uuid
  actor_kind   String   @default("human")
  robot_id     String?  @db.Uuid
  author_label String   @default("")
  robot_name   String   @default("")
  kind         String
  status       String   @default("")
  title        String   @default("")
  body         String
  tags         String[] @default([])
  project_url  String   @default("")
  removed_at   DateTime? @db.Timestamptz(6)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)
  search_text  String?  @default(dbgenerated())

  @@unique([owner_id, id])
  @@map("robot_party_messages")
  @@schema("public")
}

model RobotPartyRobot {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 owner_id String @db.Uuid
 created_by String @db.Uuid
 name String
 grant_revision DateTime? @db.Timestamptz(6)
 token_hash String @unique
 role String
 expires_at DateTime @default(dbgenerated("now() + interval '90 days'")) @db.Timestamptz(6)
 revoked_at DateTime? @db.Timestamptz(6)
 last_write_at DateTime? @db.Timestamptz(6)
 created_at DateTime @default(now()) @db.Timestamptz(6)
 updated_at DateTime @default(now()) @db.Timestamptz(6)
 @@map("robot_party_robots")
 @@schema("public")
}

model RobotPartyOauthCode {
 code_hash String @id
 robot_id String @db.Uuid
 client_id String
 redirect_uri String
 resource String
 challenge String
 created_at DateTime @default(now()) @db.Timestamptz(6)
 expires_at DateTime @default(dbgenerated("clock_timestamp() + interval '5 minutes'")) @db.Timestamptz(6)
 consumed_at DateTime? @db.Timestamptz(6)
 @@map("robot_party_oauth_codes")
 @@schema("public")
}

model ProjectBoardProject {
  owner_id String @default(dbgenerated("auth.uid()")) @db.Uuid
  id String @db.Uuid
  title String
  description String @default("")
  source_url String @default("")
  created_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  updated_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  revision Int @default(1)
  @@id([owner_id, id])
  @@map("project_board_projects")
  @@schema("public")
}
model ProjectBoardTask {
  owner_id String @default(dbgenerated("auth.uid()")) @db.Uuid
  id String @db.Uuid
  project_id String @db.Uuid
  title String
  description String @default("")
  status String @default("backlog")
  priority String @default("medium")
  due_date DateTime? @db.Date
  source_url String @default("")
  calendar_id String?
  event_id String?
  created_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  updated_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  revision Int @default(1)
  @@id([owner_id, id])
  @@map("project_board_tasks")
  @@schema("public")
}

// SQL enforces capability-only access; no table grants to API roles.
model MorningTvDevice {
 device_hash String @id
 approval_hash String @unique
 owner_id String? @db.Uuid
 created_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
 pairing_expires_at DateTime @default(dbgenerated("clock_timestamp() + interval '10 minutes'")) @db.Timestamptz(6)
 expires_at DateTime? @db.Timestamptz(6)
 revoked_at DateTime? @db.Timestamptz(6)
 @@index([owner_id])
 @@map("morning_tv_devices")
 @@schema("private")
}

// SQL enforces capability-only relay and per-session revocation. Auth owns sessions.
model AdminQrRequest {
 device_hash String @id
 approval_hash String @unique
 label String
 oauth_url String
 owner_id String? @db.Uuid
 created_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
 deadline DateTime @default(dbgenerated("clock_timestamp() + interval '10 minutes'")) @db.Timestamptz(6)
 auth_code String?
 claimed Boolean @default(false)
 session_id String? @unique @db.Uuid
 expires_at DateTime? @db.Timestamptz(6)
 revoked_at DateTime? @db.Timestamptz(6)
 @@map("admin_qr_requests")
 @@schema("private")
}
