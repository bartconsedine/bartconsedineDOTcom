  ],
  "policies": [
    {
      "cmd": "ALL",
      "qual": "(( SELECT is_site_owner() AS is_site_owner) AND (owner_id = ( SELECT auth.uid() AS uid)))",
      "roles": [
        "authenticated"
      ],
      "tablename": "app_data",
      "permissive": "PERMISSIVE",
      "policyname": "owner_private_data",
      "schemaname": "public",
      "with_check": "(( SELECT is_site_owner() AS is_site_owner) AND (owner_id = ( SELECT auth.uid() AS uid)))"
    }
  ],
  "functions": [
    {
      "anon": false,
      "name": "is_site_owner",
      "config": [
        "search_path=\"\""
      ],
      "schema": "public",
      "source": "selectexists(select1fromprivate.site_ownerojoinauth.usersuonu.id=o.user_idwhereo.user_id=(selectauth.uid())andlower(u.email)=lower(o.email)andu.email_confirmed_atisnotnullandnotcoalesce(u.is_anonymous,false)andexists(select1fromauth.identitiesiwherei.user_id=u.idandi.provider='google'));",
      "definer": true,
      "volatility": "s",
      "authenticated": true
    }
  ],
  "constraints": [
    {
      "name": "app_data_app_slug_check",
      "table": "app_data",
      "definition": "CHECK ((app_slug ~ '^[a-z0-9]+(-[a-z0-9]+)*$'::text))"
    },
    {
      "name": "app_data_key_check",
      "table": "app_data",
      "definition": "CHECK (((length(key) >= 1) AND (length(key) <= 200)))"
    },
    {
      "name": "app_data_owner_id_fkey",
      "table": "app_data",
      "definition": "FOREIGN KEY (owner_id) REFERENCES auth.users(id) ON DELETE CASCADE"
    },
    {
      "name": "app_data_pkey",
      "table": "app_data",
      "definition": "PRIMARY KEY (owner_id, app_slug, key)"
    },
    {
      "name": "site_owner_email_check",
      "table": "private.site_owner",
      "definition": "CHECK ((lower(email) = 'bartconsedine@gmail.com'::text))"
    },
    {
      "name": "site_owner_pkey",
      "table": "private.site_owner",
      "definition": "PRIMARY KEY (singleton)"
    },
    {
      "name": "site_owner_singleton_check",
      "table": "private.site_owner",
      "definition": "CHECK (singleton)"
    },
    {
      "name": "site_owner_user_id_fkey",
      "table": "private.site_owner",
      "definition": "FOREIGN KEY (user_id) REFERENCES auth.users(id) ON DELETE CASCADE"
    },
    {
      "name": "site_owner_user_id_key",
      "table": "private.site_owner",
      "definition": "UNIQUE (user_id)"
    }
  ],
  "private_usage": false
